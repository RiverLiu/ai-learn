# ===== 聊天服务（必填）=====
# 任何兼容 OpenAI 协议的聊天模型服务均可，示例为月之暗面 Kimi
OPENAI_API_KEY=sk-your-chat-api-key
OPENAI_BASE_URL=https://api.moonshot.cn/v1
MODEL_NAME=kimi-k2.6

# ===== 向量服务（可选）=====
# 不配置时自动回落到上面的 OPENAI_API_KEY / OPENAI_BASE_URL（聊天、向量同一家）。
# 国内常见"聊天一家、向量一家"：例如向量单独用阿里云百炼，就填下面三个：
EMBEDDING_API_KEY=sk-your-embedding-api-key
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v3
