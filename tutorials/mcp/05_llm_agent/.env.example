# 复制本文件为 .env 并填入真实配置（.env 已被 .gitignore 忽略，不会提交）
OPENAI_API_KEY=sk-...

# 使用兼容 OpenAI 协议的服务时配置 base_url 和模型名，例如 Kimi Code（需会员，
# API Key 在 Kimi Code 控制台创建，文档：https://www.kimi.com/code/docs/en/）：
# OPENAI_BASE_URL=https://api.kimi.com/coding/v1
# MODEL_NAME=kimi-for-coding

# 其他兼容服务示例（DeepSeek）：
# OPENAI_BASE_URL=https://api.deepseek.com/v1
# MODEL_NAME=deepseek-chat
